<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Keep JSON/API responses from Express instead of replacing them with IIS error pages. -->
    <httpErrors existingResponse="PassThrough" />

    <!-- Plesk for Windows uses iisnode. Route the startup file through that handler. -->
    <handlers>
      <remove name="iisnode" />
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- WebSocket requests need the same Node entry point as the REST/API requests. -->
    <rewrite>
      <rules>
        <clear />
        <rule name="EvoHatch-WebSocket" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^ws/(device|browser)$" />
          <action type="Rewrite" url="server.js" />
        </rule>
        <rule name="EvoHatch-Node-App" patternSyntax="ECMAScript" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- iisnode handles WebSocket upgrades. This is the standard iisnode setting. -->
    <webSocket enabled="false" />

    <!-- Keep one process: state and WebSocket connections are in-memory. -->
    <iisnode devErrorsEnabled="false"
             loggingEnabled="true"
             nodeProcessCountPerApplication="1"
             maxConcurrentRequestsPerProcess="1024"
             maxNamedPipeConnectionRetry="100"
             namedPipeConnectionRetryDelay="250" />
  </system.webServer>
</configuration>
