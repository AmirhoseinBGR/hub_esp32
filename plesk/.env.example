# Create a private .env file in this folder (never publish it) or set these values in Plesk.
NODE_ENV=production
# PORT=3000 is only for local standalone testing. On Plesk Windows, iisnode supplies
# PORT as a named-pipe path; do not override it in Plesk or in the deployed .env.
# PORT=3000
HOST=0.0.0.0
PUBLIC_ORIGIN=https://monitor.deuteriumstudio.ir

# Panel login. Use a unique username and a long, unique password (12+ characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Generate each secret independently with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-hex-characters
DEVICE_ID=hub-01
DEVICE_TOKEN=replace-with-a-different-64-hex-character-token

# Optional tuning
DEVICE_TIMEOUT_MS=15000
COMMAND_TIMEOUT_MS=10000
